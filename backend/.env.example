# Backend Configuration for Mimoo Portfolio

# Port (default: 3001)
PORT=3001

# GetPronto API Key (from GitHub Secrets)
# Get this from your GetPronto account dashboard
GETPRONTO_API_KEY=your_api_key_here

# Frontend URL (for CORS)
# In production, set this to your portfolio domain
FRONTEND_URL=http://localhost:3000
